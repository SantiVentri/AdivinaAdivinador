<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.PanelBienvenida">
  <grid id="27dc6" binding="raiz" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-1"/>
      <foreground color="-1"/>
    </properties>
    <border type="none"/>
