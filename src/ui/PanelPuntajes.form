<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.PanelPuntajes">
  <grid id="27dc6" binding="raiz" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="8d341" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="20" left="20" bottom="10" right="20" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <foreground color="-16777216"/>
          <horizontalAlignment value="0"/>
          <text value="Puntajes"/>
        </properties>
      </component>
      <scrollpane id="b71c2" binding="scrollTabla">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="20" bottom="10" right="20" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b71c3" class="javax.swing.JTable" binding="tablaPuntajes">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="b71c4" class="javax.swing.JLabel" binding="lblSinPuntajes">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="20" bottom="10" right="20" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <foreground color="-16777216"/>
          <horizontalAlignment value="0"/>
          <text value="Todavía no hay puntajes registrados."/>
        </properties>
      </component>
      <component id="e4ea8" class="javax.swing.JButton" binding="btnSalir">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="20" bottom="20" right="20" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Volver"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
