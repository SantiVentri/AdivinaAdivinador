<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.PanelJuego">
  <grid id="27dc6" binding="raiz" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="515" height="415"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="6acd7" binding="contenedorTablero" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children/>
      </grid>
      <grid id="65cec" binding="contenedorFiltros" layout-manager="GridBagLayout">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children/>
      </grid>
      <grid id="a2bf3" binding="contenedorRegistros" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children>
          <component id="7c1e3" class="javax.swing.JButton" binding="btnTerminarPartida">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="5" left="5" bottom="0" right="5" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Terminar partida"/>
            </properties>
          </component>
          <component id="7c1e4" class="javax.swing.JButton" binding="btnArriesgarPersonaje">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="5" left="5" bottom="5" right="5" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Arriesgar personaje"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
