<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.PanelLogs">
  <grid id="f3a1c" binding="raiz" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="250" height="520"/>
    </constraints>
    <properties>
      <background color="-3355444"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="f3a1d" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <foreground color="-16777216"/>
          <horizontalAlignment value="0"/>
          <text value="Logs"/>
        </properties>
      </component>
      <scrollpane id="f3a1e" binding="scrollLogs">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="0" left="5" bottom="5" right="5" weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f3a1f" class="javax.swing.JTextArea" binding="txtLogs">
            <constraints/>
            <properties>
              <editable value="false"/>
              <lineWrap value="true"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
