<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ui.PanelEspectador">
  <grid id="5e0a1" binding="raiz" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="515" height="415"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="5e0a2" binding="contenedorTablero" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children/>
      </grid>
      <grid id="5e0a3" binding="contenedorControles" layout-manager="GridBagLayout">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children>
          <component id="5e0a4" class="javax.swing.JLabel" binding="lblTurno">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="10" left="15" bottom="5" right="10" weightx="1.0" weighty="1.0"/>
            </constraints>
            <properties>
              <foreground color="-16777216"/>
              <text value="Turno"/>
            </properties>
          </component>
          <component id="5e0a5" class="javax.swing.JLabel" binding="lblDetalle">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="0" left="15" bottom="10" right="10" weightx="1.0" weighty="1.0"/>
            </constraints>
            <properties>
              <foreground color="-12566464"/>
              <text value="Detalle"/>
            </properties>
          </component>
          <component id="5e0a6" class="javax.swing.JButton" binding="btnSiguiente">
            <constraints>
              <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="10" left="10" bottom="10" right="15" weightx="0.0" weighty="0.0" ipadx="30" ipady="15"/>
            </constraints>
            <properties>
              <text value="Siguiente turno"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="5e0a7" binding="contenedorRegistros" layout-manager="GridBagLayout">
        <constraints>
          <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag top="5" left="5" bottom="5" right="5" weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="line">
          <color color="-16777216"/>
        </border>
        <children>
          <component id="5e0a8" class="javax.swing.JButton" binding="btnTerminarPartida">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="5" left="5" bottom="5" right="5" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Terminar partida"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
